{
  "manifest_version": 3,
  "name": "Screen Select",
  "version": "1.7.0",
  "description": "Select text from anything on screen, even videos, then copy, translate, search or ask AI.",
  "permissions": ["activeTab", "scripting", "offscreen", "clipboardWrite", "search", "storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://integrate.api.nvidia.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Screen Select (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" }
    }
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
